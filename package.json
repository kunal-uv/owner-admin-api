{
  "name": "owner-admin-api",
  "version": "0.1.0",
  "private": true,
  "description": "Control-plane API for the owner admin: products, plans, clients (tenants), billing, entitlements and audit.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "prisma migrate deploy && node build/index.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:local:init": "initdb -D .pgdata -U postgres --auth=trust -E UTF8 --locale=C",
    "db:local:start": "pg_ctl -D .pgdata -o \"-p 5433\" -l .pgdata/server.log -w start",
    "db:local:stop": "pg_ctl -D .pgdata -w stop",
    "test": "tsx --import ./test/setup.ts --test --test-concurrency=1 test/*.test.ts",
    "setup": "tsx src/scripts/create-owner.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "setup:prod": "node build/scripts/create-owner.js",
    "add:rentbuddyz": "node build/scripts/add-rentbuddyz.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^7.0.13",
    "otplib": "^12.0.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
